# Environment: development | production
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# JWT signing secret (set a strong random value in production)
JWT_SECRET=change-this-secret

# Allowed CORS origin for the frontend (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Admin accounts are no longer seeded — create/update rows in the `admins` table
# directly (see server/README.md). ADMIN_EMAIL below is only used as a fallback
# "notify this address" target for invite-progress emails, not for login.
ADMIN_EMAIL=admin@togglenow.com

# SMTP settings for sending magic-login invite emails (via nodemailer).
# If SMTP_HOST is left blank, invite emails are logged to the server console
# instead of actually sent — good for local testing without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ToggleNow Experience Center <no-reply@togglenow.com>"

# Base URL of the frontend, used to build magic-login links (e.g. FRONTEND_URL/magic/<token>)
FRONTEND_URL=http://localhost:5173

# Production database (MySQL) — either provide DATABASE_URL, or the discrete vars below
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=togglenow_cms
